# Copy to .env and edit. Everything works with the defaults (offline mode, no keys).
LLM_PROVIDER=offline            # offline | anthropic | openai | vllm
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
EMBEDDING_BACKEND=hash          # hash (no download) | hf (sentence-transformers)
# Docker Compose overrides these to use Postgres / Redis / Chroma server:
DATABASE_URL=sqlite:///./data/paperpilot.db
REDIS_URL=
